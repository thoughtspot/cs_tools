guid: 8cdef804-d931-4006-b212-25c9238d2a2b
table:
  name: TS_SCHEDULE_RUN
  description: |-
    One row per execution of a Liveboard schedule.

    ThoughtSpot only keeps about 30 days of run history, so this table accumulates it across extracts.

    https://docs.thoughtspot.com/cloud/latest/liveboard-schedule
  db: << DATABASE >>
  schema: << SCHEMA >>
  db_table: TS_SCHEDULE_RUN
  connection:
    name: << CONNECTION_NAME >>
  columns:
  - name: CLUSTER_GUID
    description: This column is only used for JOINs.
    db_column_name: CLUSTER_GUID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      is_hidden: true
    db_column_properties:
      data_type: VARCHAR
  - name: ORG_ID
    description: This column is only used for JOINs.
    db_column_name: ORG_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      is_hidden: true
    db_column_properties:
      data_type: INT64
  - name: SCHEDULE_GUID
    description: This column is only used for JOINs.
    db_column_name: SCHEDULE_GUID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      is_hidden: true
    db_column_properties:
      data_type: VARCHAR
  - name: Run GUID
    description: The unique identifier of the run.
    db_column_name: RUN_GUID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: VARCHAR
  - name: Run Started At
    description: The datetime the run started.
    db_column_name: STARTED
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DATE_TIME
  - name: Run Ended At
    description: The datetime the run finished.
    db_column_name: ENDED
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DATE_TIME
  - name: Run Status
    description: "The outcome of the run (SUCCESS, FAILED)."
    db_column_name: STATUS
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: Run Detail
    description: The message ThoughtSpot recorded for the run, including the error for a failed run.
    db_column_name: DETAIL
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: VARCHAR
  joins_with:
  - name: TS_SCHEDULE_RUN_to_TS_CLUSTER
    destination:
      name: TS_CLUSTER
    "on": "[TS_SCHEDULE_RUN::CLUSTER_GUID] = [TS_CLUSTER::Cluster GUID]"
    type: INNER
  - name: TS_SCHEDULE_RUN_to_TS_ORG
    destination:
      name: TS_ORG
    "on": "[TS_SCHEDULE_RUN::CLUSTER_GUID] = [TS_ORG::CLUSTER_GUID] AND [TS_SCHEDULE_RUN::ORG_ID] = [TS_ORG::Org ID]"
    type: INNER
  properties:
    spotter_config:
      is_spotter_enabled: false
